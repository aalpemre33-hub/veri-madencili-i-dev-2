### veri setini oluşturma
set.seed(123) 
n <- 100 
## bağımsız değişkenleri bulma 
x1 <- rnorm(n, mean = 8, sd = 2)
x2 <- rnorm(n, mean = 5, sd = 1)
x3 <- rnorm(n, mean = 3, sd = 0.5)
x4 <- rnorm(n, mean = 6, sd = 1.5)
x5 <- rnorm(n, mean = 10, sd = 3)
x6 <- rnorm(n, mean = 8, sd = 2)
## bağımlı değişken 
y <- 3 + 2*x1 - 1.5*x2 + 0.5*x3 + 1.8*x4 - 1.2*x5 + 0.8*x6 + rnorm(n, mean = 0, sd = 2)

##Veri çerçevesi
data <- data.frame(y, x1, x2, x3, x4, x5, x6)
head(data)
