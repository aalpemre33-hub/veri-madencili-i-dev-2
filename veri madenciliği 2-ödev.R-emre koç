## Eksik veriyi kontrol ve doldurma işlemi yaptım.
set.seed(123)
x1_tt <- rnorm(n, mean = 10, sd = 2)
x2_tt <- rnorm(n, mean = 5,  sd = 1)
y_tt  <- rnorm(n, mean = 3 + 2*x1_tt - 1.5*x2_tt, sd = 2)
## eksik veri var mı yok mu ona baktım
is_na_x1 <- is.na(x1_tt)
is_na_x2 <- is.na(x2_tt)
##ortalama ile doldurma 
mean_x1_tt <- mean(x1_tt, na.rm = TRUE)
x1_filled  <- ifelse(is.na(x1_tt), mean_x1_tt, x1_tt)
### LOCF yöntemi kullandım. Yukarıdaki  zoo kütüphanemden 
##na.locf()veri setlerindeki eksik değerleri (NA) 
##bir önceki geçerli (NA olmayan) değerle doldurdum.
vec        <- c(1, NA, NA, 4, NA, 6, NA, 8, NA)
vec_filled <- na.locf(vec)
print(vec_filled)

x2_filled <- na.locf(x2_tt)
median_y_tt <- median(y_tt, na.rm = TRUE)
y_filled    <- ifelse(is.na(y_tt), median_y_tt, y_tt)

## aykırı değerleri buldum.
set.seed(123)
data_aykiri <- rnorm(100)
boxplot(data_aykiri, main = "Kutu Grafigi")
## z puanını bulalım 
z_scores     <- scale(data_aykiri)
outliers_z   <- abs(z_scores) > 3
summary(z_scores )
### IQR yöntemini kullanalım.
Q1           <- quantile(data_aykiri, 0.25)
Q3           <- quantile(data_aykiri, 0.75)
IQR_val      <- Q3 - Q1
lower_bound  <- Q1 - 1.5 * IQR_val
upper_bound  <- Q3 + 1.5 * IQR_val
outliers_iqr <- data_aykiri < lower_bound | data_aykiri > upper_bound
summary(outliers_iqr)
